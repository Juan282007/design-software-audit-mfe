{
  "consumer": {
    "name": "audit-mfe"
  },
  "interactions": [
    {
      "description": "a paginated audit-record listing request",
      "request": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer pact-contract-token"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/audit-records",
        "query": {
          "limit": [
            "10"
          ]
        }
      },
      "response": {
        "body": {
          "data": [
            {
              "actor_id": null,
              "entity_id": null,
              "entity_type": null,
              "event_id": "10000000-0000-4000-8000-000000000002",
              "event_occurred_at": null,
              "event_type": "USER_LOGIN",
              "id": "10000000-0000-4000-8000-000000000001",
              "received_at": "2026-10-18T12:00:00Z",
              "source_service": "iam-service"
            }
          ],
          "pagination": {
            "has_more": false,
            "limit": 10,
            "next_cursor": null
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].event_id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.data[*].event_type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.data[*].received_at": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ssX",
                  "match": "datetime"
                }
              ]
            },
            "$.data[*].source_service": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagination.has_more": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagination.limit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "15.0.1"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "audit-query-api"
  }
}